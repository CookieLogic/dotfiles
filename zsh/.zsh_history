: 1775252324:0;for pair in $(kubectl --context magic.teleport.sh-training-euw4 get nodes -l k8s.magic.dev/gpu-type=gb200 -o json | python3 -c\
   "\
  import json, sys\
  data = json.load(sys.stdin)\
  pools = {}\
  for node in data['items']:\
      labels = node['metadata']['labels']\
      pool = labels.get('k8s.magic.dev/gcp-node-pool-name', 'unknown')\
      if pool not in pools:\
          pools[pool] = node['metadata']['name']\
  for pool, name in sorted(pools.items()):\
      print(f'{pool}:{name}')\
  "); do\
    pool=${pair%%:*}\
    node=${pair##*:}\
    echo "--- $pool: $node ---"\
    kubectl --context magic.teleport.sh-training-euw4 run gpu-audit-${pool} --rm -it -n sre-play \\
      --image=nvcr.io/nvidia/cuda:12.6.0-base-ubuntu22.04 --restart=Never \\
      --overrides="{\"spec\":{\"runtimeClassName\":\"nvidia\",\"nodeName\":\"${node}\",\"tolerations\":[{\"operator\":\"Exists\"\
  }],\"containers\":[{\"name\":\"gpu-audit-${pool}\",\"image\":\"nvcr.io/nvidia/cuda:12.6.0-base-ubuntu22.04\",\"command\":[\"nv\
  idia-smi\",\"--query-gpu=name,vbios_version,driver_version\",\"--format=csv,noheader\"],\"securityContext\":{\"allowPrivilegeE\
  scalation\":false,\"runAsNonRoot\":true,\"runAsUser\":1000,\"capabilities\":{\"drop\":[\"ALL\"]},\"seccompProfile\":{\"type\":\
  \"RuntimeDefault\"}},\"resources\":{}}]}}" \\
      2>&1 | grep -v "^Warning\|^error:\|^warning:"\
  done
: 1775252389:0;for pair in $(kubectl --context magic.teleport.sh-training-euw4 get nodes -l k8s.magic.dev/gpu-type=gb200 -o json | python3 -c\
   "\
  import json, sys\
  data = json.load(sys.stdin)\
  blocks = {}\
  for node in data['items']:\
      labels = node['metadata']['labels']\
      block = labels.get('k8s.magic.dev/nvlink-block', 'unknown')\
      if block not in blocks:\
          blocks[block] = node['metadata']['name']\
  for i, (block, name) in enumerate(sorted(blocks.items())):\
      print(f'{i}:{name}')\
  "); do\
    idx=${pair%%:*}\
    node=${pair##*:}\
    echo "--- Block $idx: $node ---"\
