      --image=nvcr.io/nvidia/cuda:12.6.0-base-ubuntu22.04 --restart=Never \\
      --overrides="{\"spec\":{\"runtimeClassName\":\"nvidia\",\"nodeName\":\"${node}\",\"tolerations\":[{\"operator\":\"Exists\"\
  }],\"containers\":[{\"name\":\"gpu-audit-b${idx}\",\"image\":\"nvcr.io/nvidia/cuda:12.6.0-base-ubuntu22.04\",\"command\":[\"nv\
  idia-smi\",\"--query-gpu=name,vbios_version,driver_version\",\"--format=csv,noheader\"],\"securityContext\":{\"allowPrivilegeE\
  scalation\":false,\"runAsNonRoot\":true,\"runAsUser\":1000,\"capabilities\":{\"drop\":[\"ALL\"]},\"seccompProfile\":{\"type\":\
  \"RuntimeDefault\"}},\"resources\":{}}]}}" \\
      2>&1 | grep -v "^Warning\|^error:\|^warning:"\
  done
: 1775252419:0;kubectl --context magic.teleport.sh-training-euw4 get nodes -l k8s.magic.dev/gpu-type=gb200 -o json | python3 -c "\
  import json, sys, subprocess\
\
  data = json.load(sys.stdin)\
  pools = {}\
  for node in data['items']:\
      labels = node['metadata']['labels']\
      pool = labels.get('k8s.magic.dev/gcp-node-pool-name', 'unknown')\
      if pool not in pools:\
          pools[pool] = node['metadata']['name']\
\
  for i, (pool, node) in enumerate(sorted(pools.items())):\
      pod_name = f'gpu-audit-{i}'\
      print(f'--- {pool}: {node} ---')\
      subprocess.run([\
          'kubectl', '--context', 'magic.teleport.sh-training-euw4',\
          'run', pod_name, '--rm', '-it', '-n', 'sre-play',\
          '--image=nvcr.io/nvidia/cuda:12.6.0-base-ubuntu22.04',\
          '--restart=Never',\
          '--overrides', json.dumps({\
              'spec': {\
                  'runtimeClassName': 'nvidia',\
                  'nodeName': node,\
                  'tolerations': [{'operator': 'Exists'}],\
                  'containers': [{\
                      'name': pod_name,\
                      'image': 'nvcr.io/nvidia/cuda:12.6.0-base-ubuntu22.04',\
                      'command': ['nvidia-smi', '--query-gpu=name,vbios_version,driver_version', '--format=csv,noheader'],\
                      'securityContext': {\
                          'allowPrivilegeEscalation': False,\
                          'runAsNonRoot': True,\
                          'runAsUser': 1000,\
                          'capabilities': {'drop': ['ALL']},\
                          'seccompProfile': {'type': 'RuntimeDefault'}\
                      },\
                      'resources': {}\
                  }]\
              }\
          })\
      ])\
  "
