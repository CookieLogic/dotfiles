: 1774301255:0;for p in $(gcloud projects list | tail -n+2 | cut -d' ' -f1) ; do\
  gcloud services list --enabled 2>/dev/null | grep -E '(artifactregistry|container).googleapis.com' >/dev/null 2>&1\
  if [ $? -ne 0 ] ; then continue ; fi\
\
  gar=0\
  l="$(gcloud artifacts repositories list --project $p --format 'json' 2>/dev/null | jq 'length')"\
  if [ "$l" -gt 0 ] ; then gar=1 ; fi\
\
  gcr=0\
  l2="$(gcloud container clusters list --project $p --format 'json' 2>/dev/null | jq 'length')"\
  if [ "$l2" -gt 0 ] ; then gcr=1 ; fi\
  \
  echo "${p}: GAR=${gar} GCR=${gcr}"\
done
