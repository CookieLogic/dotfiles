: 1774029626:0;PROJECT_ID="product-infra-0qtlugqu"\
\
gcloud iam service-accounts list \\
  --project=$PROJECT_ID \\
  --format="value(email)" | while read SA; do\
    COUNT=$(gcloud compute os-login ssh-keys list \\
      --impersonate-service-account=$SA \\
      --format=json 2>/dev/null | \\
      jq '[.[] | select(.expirationTimeUsec == null)] | length')\
    if [ "$COUNT" -gt 0 ]; then\
      echo "$SA: $COUNT keys with no expiry"\
    fi\
  done
: 1774029626:0;PROJECT_ID="product-infra-0qtlugqu"\
\
gcloud iam service-accounts list \\
  --project=$PROJECT_ID \\
  --format="value(email)" | while read SA; do\
    gcloud compute os-login ssh-keys list \\
      --impersonate-service-account=$SA \\
      --format=json 2>/dev/null | \\
      jq -r '.[] | select(.expirationTimeUsec == null) | .fingerprint' | \\
      while read FP; do\
        gcloud compute os-login ssh-keys remove \\
          --key=$FP \\
          --impersonate-service-account=$SA\
      done\
  done
: 1774029626:0;clear
: 1774029626:0;ls
: 1774029626:0;claude
